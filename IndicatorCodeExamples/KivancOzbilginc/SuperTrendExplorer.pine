t63 = input(title="BIST:SELEC", defval="BIST:SELEC")
t64 = input(title="BIST:MGROS", defval="BIST:MGROS")
t65 = input(title="BIST:NUHCM", defval="BIST:NUHCM")
t66 = input(title="BIST:PKENT", defval="BIST:PKENT")

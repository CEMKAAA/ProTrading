//@version=5
//name inspired by @mavilim0732
//creator&author: KIVANÇ ÖZBİLGİÇ
indicator('MavilimW Screener', 'MavW Screener', overlay=true, format=format.price)
fmal = input(3, 'First Moving Average length')
smal = input(5, 'Second Moving Average length')
src = input(close)
_type = input(false, title='Change Screener to show MavilimW & Price Flips')
mavilimold = input(false, title='Show Previous Version of MavilimW?')
tmal = fmal + smal
Fmal = smal + tmal
Ftmal = tmal + Fmal
Smal = Fmal + Ftmal
M1 = ta.wma(src, fmal)
M2 = ta.wma(M1, smal)
M3 = ta.wma(M2, tmal)
M4 = ta.wma(M3, Fmal)
M5 = ta.wma(M4, Ftmal)
MAVW = ta.wma(M5, Smal)
col1 = MAVW > MAVW[1]
col3 = MAVW < MAVW[1]
colorM = col1 ? color.blue : col3 ? color.red : color.yellow
M12 = ta.wma(src, 3)
M22 = ta.wma(M12, 5)
M32 = ta.wma(M22, 8)
M42 = ta.wma(M32, 13)
M52 = ta.wma(M42, 21)
MAVW2 = ta.wma(M52, 34)
plot(MAVW, color=colorM, linewidth=2, title='MAVW')
plot(mavilimold and MAVW2 ? MAVW2 : na, color=color.new(color.blue, 0), linewidth=2, title='MavWOld')
cro= _type ? ta.crossover(close, MAVW) : ta.crossover(MAVW, MAVW[1])
cru= _type ? ta.crossunder(close, MAVW) : ta.crossunder(MAVW, MAVW[1])
direction = 0
direction := cro ? 1 : cru ? -1 : direction[1]
alertcondition(ta.crossover(MAVW, MAVW[1]), title='MAVW BUY', message='MAVW BUY!')
alertcondition(ta.crossunder(MAVW, MAVW[1]), title='MAVW SELL', message='MAVW SELL!')
alertcondition(ta.cross(MAVW, MAVW[1]), title='Color ALARM', message='MavilimW has changed color!')
string gr_sc = 'SCREENER'
string gr_sy = 'SYMBOL'
string t00 = 'MavilimW Screener'
color c00 = #686868
lb_sh = input.bool(title='Show Label', defval=true, group=gr_sc)
lb_sz = input.string(title='Label Size', options=['Auto', 'Tiny', 'Small', 'Normal', 'Large', 'Huge'], defval='Normal', group=gr_sc)
lb_xa = input.int(title='Horizontal Axis', defval=20, group=gr_sc, tooltip='Label Position x Axis')
lb_ya = input.int(title='Vertical Axis', defval=1, group=gr_sc, tooltip='Label Position y Axis')
lb_cl = input.color(title='Colours', defval=#00bb00, group=gr_sc, inline='0')
lb_cs = input.color(title='', defval=#ff0000, group=gr_sc, inline='0')
sh01 = input.bool(title='01', defval=true, group=gr_sy, inline="01")

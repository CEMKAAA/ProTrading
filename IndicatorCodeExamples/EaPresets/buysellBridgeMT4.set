InpInvertDirection=false
InpSendRegistrationOnInit=true
InpHeartbeatSeconds=300
InpSignalAbsMin=0.0000001
InpAllowBuy=true
InpAllowSell=true
InpApiBaseUrl=http://127.0.0.1
InpApiPath=/api/v1/mt4/bridge/signal
InpBridgeToken=

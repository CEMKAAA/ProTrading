InpIndicatorName=Atomic
InpPollSeconds=1
InpLogOnInit=true
InpLogOnlyOnChange=true
InpDebugObjects=false
InpLogPostResponses=false
InpLogHandshakeResponses=true
InpLogNoneSignals=false
InpLogRegimeBuffer=false
InpInitialSetupRetrySeconds=30
InpIgnoreNamePatterns=autotrade,->
InpEnableProTradePost=true
InpSendUnregisterOnDeinit=true
InpSendInitialConfirmedOnStart=false
InpResolvedHeartbeatSeconds=300
InpRegisterHeartbeatSeconds=120
InpApiBaseUrl=http://127.0.0.1
InpApiPath=/api/v1/mt4/bridge/signal
InpBridgeToken=
InpSignalProfile=atomic
InpHttpTimeoutMs=5000
InpEnableRegimeChangePost=true
InpSendInitialRegimeConfirmedOnStart=false
InpRegimeSignalProfile=atomic_regime
InpRegimeIndicatorName=AtomicRegime
InpRegimeAtrPeriod=14
InpRegimeAtrMultiplier=3.0
InpRegimeRR=3.0
InpRegimeMinRiskPricePct=0.0020
InpRegimeMinRiskPoints=0.0
InpRegimeUseTrendSignalBuffers=true
InpRegimeUpTrendSignalBuffer=2
InpRegimeDnTrendSignalBuffer=3
InpRegimeUseTrendStopBuffers=false
InpRegimeUpTrendStopBuffer=0
InpRegimeDnTrendStopBuffer=1
InpRegimeUseAtomicSignalAsTieBreak=true
InpRegimeUseClosedBar=false
InpRegimeBufferLookbackBars=200
InpRegimeConfirmStableSeconds=5
InpRegimeMaxConfirmShift=1

InpIndicatorName=SIGNATICS-ALGO V2 (2)
InpPollSeconds=1
InpLogOnInit=true
InpLogInitialSetup=true
InpLogOnlyOnChange=true
InpDebugObjects=false
InpDebugDiscoveryOnNone=false
InpNoneDiscoveryIntervalSeconds=10
InpNoneLogIntervalSeconds=300
InpInitialSetupRetrySeconds=30
InpLogInitialDiscoverySummary=true
InpIgnoreNamePatterns=autotrade,->
InpEnableProTradePost=true
InpSendUnregisterOnDeinit=true
InpSendInitialConfirmedOnStart=false
InpSendResolvedStateEvents=true
InpResolvedHeartbeatSeconds=900
InpRegisterHeartbeatSeconds=120
InpApiBaseUrl=http://127.0.0.1
InpApiPath=/api/v1/mt4/bridge/signal
InpBridgeToken=
InpSignalProfile=signatics
InpBridgeSignalMode=buffer
InpHttpTimeoutMs=5000
InpPreferGroupedSetup=true
InpAllowDashboardFallback=false
InpRejectInvalidGeometry=true
InpMaxGroupCandidates=300
InpAllowLevelObjectFallback=false
InpLogOnlyTradeSignals=true
InpLogPostResponses=false
InpLogHandshakeResponses=true
InpLogRejectedGeometry=false
InpMaxConfirmedBarAgeSeconds=180
InpEnableFastSignalBuffers=true
InpFastBuyBufferIndex=0
InpFastSellBufferIndex=1
InpFastSignalLookbackBars=2
InpFastSignalHistoryLookbackBars=1000
InpSendBufferHistoryResolvedOnInit=true
InpLogFastBufferSignals=true
InpScanFastBuffersOnTick=true
InpBufferHistoryNoneLogSeconds=300
InpAllowObjectConfirmedFallback=false
InpChartObjectStrictGroups=true
InpChartObjectRequireAllTps=true
InpChartObjectMaxSlotTimeSkewSeconds=5
InpChartObjectStableSeconds=1
InpChartObjectRequireFreshConfirmed=true

# ProTrading Dashboard - Environment Configuration Example
# Copy this file to .env and modify as needed

# ===================
# Backend Configuration
# ===================

# Database URL (SQLite for development, PostgreSQL for production)
DATABASE_URL=sqlite:///./dashboard/data/trading.db
# DATABASE_URL=postgresql://user:password@localhost:5432/protrading

# Log Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# CORS Origins (comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# ===================
# Frontend Configuration
# ===================

# API Base URL (for frontend to connect to backend)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# ===================
# MetaTrader 5 Configuration (Optional)
# ===================

# MT5 Account Credentials (for live trading features)
# MT5_LOGIN=your_account_number
# MT5_PASSWORD=your_password
# MT5_SERVER=your_broker_server

# ===================
# Security Configuration
# ===================

# Secret key for JWT tokens (generate a secure random string)
# SECRET_KEY=your-super-secret-key-here

# ===================
# Production Configuration
# ===================

# Set to 'production' in production environment
# ENVIRONMENT=development

# Enable HTTPS redirect in production
# FORCE_HTTPS=false

#property strict
#include "../../IndicatorCodeExamples/universal/UniversalAuthority.mqh"
#include "../../IndicatorCodeExamples/universal/UniversalAuthorityKey.mqh"
void OnStart(){int passed=0,failed=0;ulong started=GetTickCount64();
if(UcRsaVerify("command=audit\nname=Proof / Turkish Unicode: çşı\nissued=1\nexpires=16","",UC_AUTHORITY_MODULUS)==true)passed++;else{failed++;Print("FAIL valid");}
if(UcRsaVerify("command=audit\nname=Proof / Turkish Unicode: çşı\nissued=1\nexpires=16x","",UC_AUTHORITY_MODULUS)==false)passed++;else{failed++;Print("FAIL tampered");}
if(UcRsaVerify("command=audit\nname=Proof / Turkish Unicode: çşı\nissued=1\nexpires=16","",UC_AUTHORITY_MODULUS)==false)passed++;else{failed++;Print("FAIL wrong-key");}
if(UcRsaVerify("command=audit\nname=Proof / Turkish Unicode: çşı\nissued=1\nexpires=16","",UC_AUTHORITY_MODULUS)==false)passed++;else{failed++;Print("FAIL zero");}
if(UcRsaVerify("command=audit\nname=Proof / Turkish Unicode: çşı\nissued=1\nexpires=16","",UC_AUTHORITY_MODULUS)==false)passed++;else{failed++;Print("FAIL equal-modulus");}
if(UcRsaVerify("command=audit\nname=Proof / Turkish Unicode: çşı\nissued=1\nexpires=16","",UC_AUTHORITY_MODULUS)==false)passed++;else{failed++;Print("FAIL short");}
if(UcRsaVerify("command=audit\nname=Proof / Turkish Unicode: çşı\nissued=1\nexpires=16","",UC_AUTHORITY_MODULUS)==false)passed++;else{failed++;Print("FAIL bad-hex");}
if(UcRsaVerify("command=audit\nname=Proof / Turkish Unicode: çşı\nissued=1\nexpires=16","",UC_AUTHORITY_MODULUS)==false)passed++;else{failed++;Print("FAIL padding-0");}
if(UcRsaVerify("command=audit\nname=Proof / Turkish Unicode: çşı\nissued=1\nexpires=16","",UC_AUTHORITY_MODULUS)==false)passed++;else{failed++;Print("FAIL padding-1");}
if(UcRsaVerify("command=audit\nname=Proof / Turkish Unicode: çşı\nissued=1\nexpires=16","",UC_AUTHORITY_MODULUS)==false)passed++;else{failed++;Print("FAIL padding-2");}
if(UcRsaVerify("command=audit\nname=Proof / Turkish Unicode: çşı\nissued=1\nexpires=16","",UC_AUTHORITY_MODULUS)==false)passed++;else{failed++;Print("FAIL padding-203");}
if(UcRsaVerify("command=audit\nname=Proof / Turkish Unicode: çşı\nissued=1\nexpires=16","",UC_AUTHORITY_MODULUS)==false)passed++;else{failed++;Print("FAIL padding-204");}
if(UcRsaVerify("command=audit\nname=Proof / Turkish Unicode: çşı\nissued=1\nexpires=16","",UC_AUTHORITY_MODULUS)==false)passed++;else{failed++;Print("FAIL padding-205");}
if(UcRsaVerify("command=audit\nname=Proof / Turkish Unicode: çşı\nissued=1\nexpires=16","",UC_AUTHORITY_MODULUS)==false)passed++;else{failed++;Print("FAIL padding-222");}
if(UcRsaVerify("command=audit\nname=Proof / Turkish Unicode: çşı\nissued=1\nexpires=16","",UC_AUTHORITY_MODULUS)==false)passed++;else{failed++;Print("FAIL padding-223");}
if(UcRsaVerify("command=audit\nname=Proof / Turkish Unicode: çşı\nissued=1\nexpires=16","",UC_AUTHORITY_MODULUS)==false)passed++;else{failed++;Print("FAIL padding-255");}
string b="command=audit\nissued=1000\nexpires=1015\ninstallationId=device\naccountLogin=123\nsymbol=JP225m\nbrokerServer=Exness\nsequence=2\naccountId=11111111-1111-1111-1111-111111111111\ngeneration=22222222-2222-2222-2222-222222222222";
if(UcAuthorityScope(b,"device","123","JP225m","Exness",1001,1)==true)passed++;else failed++;
if(UcAuthorityScope(b,"other","123","JP225m","Exness",1001,1)==false)passed++;else failed++;
if(UcAuthorityScope(b,"device","456","JP225m","Exness",1001,1)==false)passed++;else failed++;
if(UcAuthorityScope(b,"device","123","XAUUSDm","Exness",1001,1)==false)passed++;else failed++;
if(UcAuthorityScope(b,"device","123","JP225m","Other",1001,1)==false)passed++;else failed++;
if(UcAuthorityScope(b,"device","123","JP225m","Exness",1015,1)==false)passed++;else failed++;
if(UcAuthorityScope(b,"device","123","JP225m","Exness",994,1)==false)passed++;else failed++;
if(UcAuthorityScope(b,"device","123","JP225m","Exness",1001,2)==false)passed++;else failed++;
string identity="command=identity\nissued=1000\nexpires=1015\ninstallationId=device\naccountLogin=123\nsymbol=JP225m\nbrokerServer=Exness\nsequence=2\naccountId=11111111-1111-1111-1111-111111111111\nsubscriberName=Cem Quant\nsubscriptionActive=true\nsubscriptionUntil=2000\ncontrollerActive=false";
identity+="\naccessMode=paid\ntrialUntil=0";
if(UcIdentityScope(identity,"device","123","JP225m","Exness",1001,1)==true)passed++;else failed++;
if(UcIdentityScope(identity,"other","123","JP225m","Exness",1001,1)==false)passed++;else failed++;
if(UcIdentityScope(identity,"device","456","JP225m","Exness",1001,1)==false)passed++;else failed++;
if(UcIdentityScope(identity,"device","123","XAUUSDm","Exness",1001,1)==false)passed++;else failed++;
if(UcIdentityScope(identity,"device","123","JP225m","Other",1001,1)==false)passed++;else failed++;
if(UcIdentityScope(identity,"device","123","JP225m","Exness",1015,1)==false)passed++;else failed++;
if(UcIdentityScope(identity,"device","123","JP225m","Exness",994,1)==false)passed++;else failed++;
if(UcIdentityScope(identity,"device","123","JP225m","Exness",1001,2)==false)passed++;else failed++;
if(!UcAuthorityScope(identity,"device","123","JP225m","Exness",1001,1))passed++;else failed++;
if(!UcIdentityScope(b,"device","123","JP225m","Exness",1001,1))passed++;else failed++;
string demo=identity;StringReplace(demo,"accessMode=paid","accessMode=demo");StringReplace(demo,"trialUntil=0","trialUntil=2000");
if(UcIdentityScope(demo,"device","123","JP225m","Exness",1001,1))passed++;else failed++;
StringReplace(demo,"trialUntil=2000","trialUntil=1000");
if(!UcIdentityScope(demo,"device","123","JP225m","Exness",1001,1))passed++;else failed++;
StringReplace(demo,"accessMode=demo","accessMode=unknown");
if(!UcIdentityScope(demo,"device","123","JP225m","Exness",1001,1))passed++;else failed++;
int f=FileOpen("Stratum/security-probe.json",FILE_WRITE|FILE_TXT|FILE_COMMON);FileWriteString(f,"{\"passed\":"+(string)passed+",\"failed\":"+(string)failed+",\"elapsedMs\":"+(string)(GetTickCount64()-started)+"}");FileClose(f);Print("UC PROOF passed=",passed," failed=",failed);}

input ORB_BROKER_TIMEZONE InpBrokerTimezone = ORB_GMT_PLUS_00_00; // BROKER UTC offset (Fixed / Legacy)
input double InpBrokerGmtOffsetHours = 0.0; // Used only when timezone = Custom
